---
// Device — foldable phone with GSAP ScrollTrigger (4 phases)
// Geometry (matches Framer exactly): W=1000 H=684 f=4 bz=8 b=12 R=46
// Each half: 500×684 (no frame margins, halves fill full device height)
// Right half: left:500. Left leaf: left:0, folds right on rotateY(180deg).
// Scale: JS-computed s = min(vw*0.9/1000, vh/684, 1.3) — no CSS media queries.
// Centering offset when closed: -(G.W/4) * s = -250*s (matches Framer's R.dev translate)
import LockScreen from './LockScreen.astro';
import CallScreen from './CallScreen.astro';
---

<div class="driver" id="driver">
  <div class="stage" id="stage">

    <!-- phone-wrap receives translateX centering (scroll) + intro transforms -->
    <div class="phone-wrap" id="phoneWrap">
      <div class="phone" id="phone">

        <!-- ── RIGHT HALF (static, shows screen content) ── -->
        <div class="phone__right" id="phoneRight">
          <div class="phone__btn phone__btn--1" aria-hidden="true"></div>
          <div class="phone__btn phone__btn--2" aria-hidden="true"></div>
          <div class="phone__slab phone__slab--R" id="phoneSlabR" aria-hidden="true"></div>
          <div class="phone__glass phone__glass--R" id="phoneGlassR" aria-hidden="true"></div>
          <div class="phone__viewport" id="phoneViewport">
            <div class="phone__crease phone__crease--R" aria-hidden="true"></div>
            <div class="phone__content" id="phoneContent"></div>
          </div>
          <div class="phone__shade phone__shade--R" id="phoneShadeR" aria-hidden="true"></div>
        </div>

        <!-- ── LEFT LEAF (folds; card-flip cover / inner faces) ── -->
        <div class="phone__left" id="phoneLeft">
          <!-- Cover face: back face (rotateY 180+180=360 = facing viewer when parent folded) -->
          <div class="phone__face phone__face--cover">
            <div class="phone__btn phone__btn--1" aria-hidden="true"></div>
            <div class="phone__btn phone__btn--2" aria-hidden="true"></div>
            <div class="phone__slab phone__slab--C" aria-hidden="true"></div>
            <div class="phone__glass phone__glass--C" aria-hidden="true"></div>
            <div class="phone__cover-screen">
              <div class="phone__crease phone__crease--C" aria-hidden="true"></div>
              <LockScreen />
              <div class="phone__cover-call" id="phoneCoverCall"></div>
            </div>
          </div>
          <!-- Inner face: front face, visible when phone is open -->
          <div class="phone__face phone__face--inner">
            <div class="phone__slab phone__slab--L" aria-hidden="true"></div>
            <div class="phone__glass phone__glass--L" aria-hidden="true"></div>
            <div class="phone__inner-screen"></div>
            <div class="phone__shade phone__shade--L" id="phoneShadeL" aria-hidden="true"></div>
          </div>
        </div>


      </div>
    </div>
  </div>
</div>

<style>
  /* ---- scroll driver ---- */
  .driver {
    position: relative;
    background: var(--color-bone);
    min-height: 100vh;
  }

  /* ---- sticky stage ---- */
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ──────────────────────────────────────────
     Phone-wrap (translate + intro transforms)
  ────────────────────────────────────────── */
  .phone-wrap {
    will-change: transform, opacity;
    opacity: 0;
  }

  /* ──────────────────────────────────────────
     Phone chassis
     W=1000 H=684 — each half is 500×684
     R=46  f=4  bz=8  b=f+bz=12
     Slab border-radii:
       Right half (cRight): 0 46 46 0
       Leaf (cLeaf):        46 0 0 46
       Cover/all (cAll):    46 46 46 46
     Inner radii: outer - offset
       glass (f=4):  outer - 4
       screen (b=12): outer - 12
  ────────────────────────────────────────── */
  .phone {
    position: relative;
    width: 1000px;
    height: 684px;
    perspective: 2800px;
    perspective-origin: center center;
    /* scale applied dynamically by JS */
    filter:
      drop-shadow(0 32px 80px rgba(0, 0, 0, 0.30))
      drop-shadow(0 6px 18px rgba(0, 0, 0, 0.22));
  }

  /* ── Right half (left:500, static) ── */
  .phone__right {
    position: absolute;
    left: 500px;
    top: 0;
    width: 500px;
    height: 684px;
    opacity: 0;
    will-change: opacity;
  }

  /* ── Graphite slab (outer body, per-half border-radius) ── */
  .phone__slab {
    position: absolute;
    background:
      linear-gradient(145deg,
        #55534F 0%,
        #343230 28%,
        #292725 55%,
        #343230 75%,
        #4E4B47 100%
      );
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.45),
      inset 0 -1px 1px rgba(0, 0, 0, 0.50),
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.65);
  }

  /* Right half slab: starts all-rounded (closed); snaps to 0 46 46 0 at 90° via JS + CSS transition */
  .phone__slab--R {
    inset: 0;
    border-radius: 46px 46px 46px 46px;
    transition: border-radius .35s cubic-bezier(.2,.7,.2,1);
  }

  /* Cover/all slab: insets(0,"none") → inset:0; corners: 46 46 46 46 */
  .phone__slab--C {
    inset: 0;
    border-radius: 46px;
  }

  /* Left leaf inner slab: insets(0,"R") → inset:0; corners: 46 0 0 46 */
  .phone__slab--L {
    inset: 0;
    border-radius: 46px 0px 0px 46px;
  }

  /* ── Dark glass ring (black bezel between slab and screen) ── */
  .phone__glass {
    position: absolute;
    background: #050505;
  }

  /* Right: insets(4,"L") → top:4 right:4 bottom:4 left:0; starts all-rounded, snaps at 90° */
  .phone__glass--R {
    top: 4px;
    right: 4px;
    bottom: 4px;
    left: 0;
    border-radius: 42px 42px 42px 42px;
    transition: border-radius .35s cubic-bezier(.2,.7,.2,1);
  }

  /* Cover/all: insets(4,"none") → inset:4; corners: 42 42 42 42 */
  .phone__glass--C {
    inset: 4px;
    border-radius: 42px;
  }

  /* Left leaf: insets(4,"R") → top:4 left:4 bottom:4 right:0; corners: 42 0 0 42 */
  .phone__glass--L {
    top: 4px;
    left: 4px;
    bottom: 4px;
    right: 0;
    border-radius: 42px 0px 0px 42px;
  }

  /* ── Screen viewport (right half content area) ── */
  /* insets(12,"L") → top:12 right:12 bottom:12 left:0; starts all-rounded, snaps at 90° */
  .phone__viewport {
    position: absolute;
    top: 12px;
    right: 12px;
    bottom: 12px;
    left: 0;
    border-radius: 34px 34px 34px 34px;
    overflow: hidden;
    background: #1a1a1a;
    transition: border-radius .35s cubic-bezier(.2,.7,.2,1);
  }

  /* Left inner screen: insets(12,"R"); hinge corners = 0px */
  .phone__inner-screen {
    position: absolute;
    top: 12px;
    left: 12px;
    bottom: 12px;
    right: 0;
    border-radius: 34px 0px 0px 34px;
    background: #e8e8e8;
  }

  .phone__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
  }

  /* ── Soft fold crease (72px wide, nearly invisible — matches Framer) ── */
  .phone__crease {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 72px;
    pointer-events: none;
    z-index: 7;
  }
  /* Right half crease: centered at left edge (hinge side) */
  .phone__crease--R {
    left: -36px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.008) 35%,
      rgba(0, 0, 0, 0.016) 50%,
      rgba(0, 0, 0, 0.008) 65%,
      transparent 100%
    );
  }
  /* Cover/left-half crease: centered at right edge (hinge side of cover when closed) */
  .phone__crease--C {
    right: -36px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.008) 35%,
      rgba(0, 0, 0, 0.016) 50%,
      rgba(0, 0, 0, 0.008) 65%,
      transparent 100%
    );
  }

  /* ── Side hardware buttons ── */
  /* right:-3 works for both right-half and cover face (double-flip preserves right side) */
  .phone__btn {
    position: absolute;
    right: -3px;
    width: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, #292725 0%, #55534F 45%, #343230 100%);
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.5);
  }
  /* Top button: 17% from top, 10% tall */
  .phone__btn--1 { top: 17%; height: 10%; }
  /* Second button: 31% from top, 6% tall */
  .phone__btn--2 { top: 31%; height: 6%; }

  /* ── Left leaf (foldable panel) ── */
  .phone__left {
    position: absolute;
    left: 0;
    top: 0;
    width: 500px;
    height: 684px;
    transform-origin: right center;   /* pivot = device centerline (x=500) */
    transform-style: preserve-3d;
    transform: rotateY(180deg);       /* closed by default */
    will-change: transform;
  }

  /* Face container: fills panel, one per side; backface-visibility hides unfacing side */
  .phone__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Cover face: back face. parent:180 + face:180 = 360 → facing viewer when closed ✓ */
  .phone__face--cover {
    transform: rotateY(180deg);
  }

  /* Cover screen content area: insets(12,"none") → inset:12; corners: 34 34 34 34 */
  .phone__cover-screen {
    position: absolute;
    inset: 12px;
    border-radius: 34px;
    overflow: hidden;
    background: #fff;
  }

  /* ── Call screen overlay (same position as right half / cover) ── */
  /* ── Fold shades (Framer: sin(th)^1.8 * 0.5 — peaks at 90°, hides corner artifacts) ── */
  .phone__shade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }
  .phone__shade--R { border-radius: 46px 46px 46px 46px; z-index: 8; transition: border-radius .35s cubic-bezier(.2,.7,.2,1); }
  .phone__shade--L { border-radius: 46px 0px 0px 46px; z-index: 8; }

  /* Black screen that fades over the lock screen on refold */
  .phone__cover-call {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  /* ──────────────────────────────────────────
     Portrait mode (mobile: vw/vh < 0.85)
     Framer GEO.portrait: W=380 H=740 f=4 bz=7 T=10 R=42
     Each half: 380×370. Leaf folds on X axis (top flips over bottom).
     cLeaf = "42 42 0 0"  (outer-top rounded, hinge-bottom flat)
     cRight = "0 0 42 42" (hinge-top flat, outer-bottom rounded)
  ────────────────────────────────────────── */
  .phone--portrait {
    width: 380px;
    height: 740px;
    perspective: 2000px;
  }

  /* Bottom half: occupies lower 370px */
  .phone--portrait .phone__right {
    left: 0;
    top: 370px;
    width: 380px;
    height: 370px;
  }

  /* Top leaf: flips on X axis, hinge at bottom */
  .phone--portrait .phone__left {
    left: 0;
    top: 0;
    width: 380px;
    height: 370px;
    transform-origin: center bottom;
    transform: rotateX(-180deg);
  }

  /* Cover face rotates on X to face viewer when leaf is closed */
  .phone--portrait .phone__face--cover {
    transform: rotateX(180deg);
  }

  /* ── Portrait slab radii ── */
  /* Bottom half (right): starts all-rounded, snaps to "0 0 42 42" at 90° */
  .phone--portrait .phone__slab--R {
    border-radius: 42px 42px 42px 42px;
  }
  /* Top leaf inner: outer-top rounded, hinge-bottom flat */
  .phone--portrait .phone__slab--L {
    border-radius: 42px 42px 0px 0px;
  }
  /* Cover face slab: all-rounded */
  .phone--portrait .phone__slab--C {
    border-radius: 42px;
  }

  /* ── Portrait glass radii ── */
  /* Bottom half: hinge at top (flush), sides/bottom inset 4px; starts all-rounded */
  .phone--portrait .phone__glass--R {
    top: 0;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 38px 38px 38px 38px;
  }
  /* Top inner face: sides/top inset 4px, hinge at bottom (flush) */
  .phone--portrait .phone__glass--L {
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 0;
    border-radius: 38px 38px 0px 0px;
  }
  /* Cover face glass: all-rounded inset 4px */
  .phone--portrait .phone__glass--C {
    inset: 4px;
    border-radius: 38px;
  }

  /* ── Portrait viewport / screens ── */
  /* Bottom viewport: hinge at top (flush), sides/bottom inset 10px */
  .phone--portrait .phone__viewport {
    top: 0;
    left: 10px;
    right: 10px;
    bottom: 10px;
    border-radius: 32px 32px 32px 32px;
  }
  /* Top inner screen: sides/top inset 10px, hinge at bottom (flush) */
  .phone--portrait .phone__inner-screen {
    top: 10px;
    left: 10px;
    right: 10px;
    bottom: 0;
    border-radius: 32px 32px 0px 0px;
  }
  /* Cover screen: all-rounded, inset 10px */
  .phone--portrait .phone__cover-screen {
    inset: 10px;
    border-radius: 32px;
  }

  /* ── Portrait creases (horizontal at hinge) ── */
  .phone--portrait .phone__crease--R {
    top: -36px;
    bottom: unset;
    left: 0;
    right: 0;
    width: unset;
    height: 72px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.008) 35%,
      rgba(0, 0, 0, 0.016) 50%,
      rgba(0, 0, 0, 0.008) 65%,
      transparent 100%
    );
  }
  /* Cover crease: at local-bottom of cover face (= visual hinge after rotateX flip) */
  .phone--portrait .phone__crease--C {
    bottom: -36px;
    top: unset;
    left: 0;
    right: 0;
    width: unset;
    height: 72px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.008) 35%,
      rgba(0, 0, 0, 0.016) 50%,
      rgba(0, 0, 0, 0.008) 65%,
      transparent 100%
    );
  }

  /* ── Portrait shades ── */
  .phone--portrait .phone__shade--R { border-radius: 42px 42px 42px 42px; }
  .phone--portrait .phone__shade--L { border-radius: 42px 42px 0px 0px; }

  /* ── Portrait buttons — shifted for shorter half height ── */
  .phone--portrait .phone__btn--1 { top: 22%; height: 12%; }
  .phone--portrait .phone__btn--2 { top: 40%; height: 7%; }

  /* ──────────────────────────────────────────
     Reduced motion — skip all animation
  ────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .phone-wrap   { opacity: 1 !important; transform: none !important; }
    .phone__right { opacity: 1 !important; }
    .phone__left  { transform: rotateY(0deg) !important; }
    .phone--portrait .phone__left { transform: rotateX(0deg) !important; }
    .phone__call  { opacity: 0 !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type Mode = 'landscape' | 'portrait';
  interface Offset { x: number; y: number; }

  // ─── Mode detection ─────────────────────────────────────────────────────────
  function getMode(): Mode {
    return window.innerWidth / window.innerHeight < 0.85 ? 'portrait' : 'landscape';
  }

  // ─── Dynamic scale + portrait class toggle ──────────────────────────────────
  function applyScale(): { s: number; mode: Mode } {
    const phone = document.getElementById('phone') as HTMLElement | null;
    if (!phone) return { s: 1, mode: getMode() };
    const mode = getMode();
    phone.classList.toggle('phone--portrait', mode === 'portrait');
    const s = mode === 'portrait'
      ? Math.min(window.innerWidth * 0.94 / 380, window.innerHeight * 0.9 / 740, 1.3)
      : Math.min(window.innerWidth * 0.9 / 1000, window.innerHeight / 684, 1.3);
    phone.style.transform       = `scale(${s})`;
    phone.style.transformOrigin = 'center center';
    return { s, mode };
  }

  // ─── Closed-phone centering offset ──────────────────────────────────────────
  // Landscape: shift left so visible right half is centered (delta = W/4 = 250).
  // Portrait:  shift up so visible top half is centered (delta = H/4 = 185).
  function getClosedOffset(s: number, mode: Mode): Offset {
    if (mode === 'portrait') return { x: 0, y: -(185 * s) };
    return { x: -(250 * s), y: 0 };
  }

  // ─── Scroll animation ───────────────────────────────────────────────────────
  function initScroll(offset: Offset, mode: Mode) {
    const driver    = document.getElementById('driver')!;
    const stage     = document.getElementById('stage')!;
    const wrap      = document.getElementById('phoneWrap')!;
    const right     = document.getElementById('phoneRight')!;
    const left      = document.getElementById('phoneLeft')!;
    const content   = document.getElementById('phoneContent')!;
    const viewport  = document.getElementById('phoneViewport')!;
    const coverCall = document.getElementById('phoneCoverCall')!;
    const shadeR    = document.getElementById('phoneShadeR')!;
    const shadeL    = document.getElementById('phoneShadeL')!;
    const slabR     = document.getElementById('phoneSlabR')!;
    const glassR    = document.getElementById('phoneGlassR')!;

    if (!driver || !stage || !wrap || !right || !left || !content || !coverCall) return;

    const screenH = viewport ? viewport.clientHeight : 660;
    gsap.set(wrap, { x: offset.x, y: offset.y });

    const innerPx  = Math.max(0, content.scrollHeight - screenH);
    const U1       = 0.7;
    const U_scroll = innerPx > 0 ? innerPx / window.innerHeight : 0;
    const U_hold   = U1 * 2;
    const U2       = 0.6;
    const U3       = 0.3;
    const totalPx  = Math.round((U1 + U_scroll + U_hold + U2 + U3) * window.innerHeight);

    driver.style.height = `calc(100vh + ${totalPx}px)`;

    // Snap-to radius values vary by orientation
    const isP = mode === 'portrait';
    const snapOpen = isP
      ? { slab: '0px 0px 42px 42px', glass: '0px 0px 38px 38px', screen: '0px 0px 32px 32px', shade: '0px 0px 42px 42px' }
      : { slab: '0px 46px 46px 0px', glass: '0px 42px 42px 0px', screen: '0px 34px 34px 0px', shade: '0px 46px 46px 0px' };
    const snapClosed = isP
      ? { slab: '42px 42px 42px 42px', glass: '38px 38px 38px 38px', screen: '32px 32px 32px 32px', shade: '42px 42px 42px 42px' }
      : { slab: '46px 46px 46px 46px', glass: '42px 42px 42px 42px', screen: '34px 34px 34px 34px', shade: '46px 46px 46px 46px' };

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: driver,
        start:   'top top',
        end:     `+=${totalPx}`,
        scrub:   0.5,
        pin:     stage,
        anticipatePin: 1,
      },
    });

    // Phase 1 — unfold: center the device, rotate leaf open, fade in right screen
    tl.to(wrap,  { x: 0, y: 0, ease: 'power2.inOut', duration: U1 }, 0);
    tl.to(left,  isP
      ? { rotateX: 0,   ease: 'power2.inOut', duration: U1 }
      : { rotateY: 0,   ease: 'power2.inOut', duration: U1 }, 0);
    tl.to(right, { opacity: 1, ease: 'none', duration: 0.05 }, 0);
    // Shades peak at 90° midpoint, then clear
    tl.to(shadeR, { opacity: 0.45, ease: 'power2.in',  duration: U1 * 0.5 }, 0);
    tl.to(shadeR, { opacity: 0,    ease: 'power2.out', duration: U1 * 0.5 }, U1 * 0.5);
    tl.to(shadeL, { opacity: 0.45, ease: 'power2.in',  duration: U1 * 0.5 }, 0);
    tl.to(shadeL, { opacity: 0,    ease: 'power2.out', duration: U1 * 0.5 }, U1 * 0.5);
    // Snap hinge corners flat at 90° — CSS transition animates the change
    tl.set(slabR,    { borderRadius: snapOpen.slab   }, U1 * 0.5);
    tl.set(glassR,   { borderRadius: snapOpen.glass  }, U1 * 0.5);
    tl.set(viewport, { borderRadius: snapOpen.screen }, U1 * 0.5);
    tl.set(shadeR,   { borderRadius: snapOpen.shade  }, U1 * 0.5);

    // Phase 2 — scroll content inside device
    if (innerPx > 0) {
      tl.to(content, { y: -innerPx, ease: 'none', duration: U_scroll }, U1);
    }

    // Phase 3 — refold: rotate leaf closed, re-center, reveal call screen
    const closeAt = U1 + U_scroll + U_hold;
    tl.to(left, isP
      ? { rotateX: -180, ease: 'power2.inOut', duration: U2 }
      : { rotateY: 180,  ease: 'power2.inOut', duration: U2 }, closeAt);
    tl.to(wrap, { x: offset.x, y: offset.y, ease: 'power2.inOut', duration: U2 }, closeAt);
    // Shades peak at 90° of refold
    tl.to(shadeR, { opacity: 0.45, ease: 'power2.in',  duration: U2 * 0.5 }, closeAt);
    tl.to(shadeR, { opacity: 0,    ease: 'power2.out', duration: U2 * 0.5 }, closeAt + U2 * 0.5);
    tl.to(shadeL, { opacity: 0.45, ease: 'power2.in',  duration: U2 * 0.5 }, closeAt);
    tl.to(shadeL, { opacity: 0,    ease: 'power2.out', duration: U2 * 0.5 }, closeAt + U2 * 0.5);
    // Snap hinge corners back to all-rounded at 90° refold
    tl.set(slabR,    { borderRadius: snapClosed.slab   }, closeAt + U2 * 0.5);
    tl.set(glassR,   { borderRadius: snapClosed.glass  }, closeAt + U2 * 0.5);
    tl.set(viewport, { borderRadius: snapClosed.screen }, closeAt + U2 * 0.5);
    tl.set(shadeR,   { borderRadius: snapClosed.shade  }, closeAt + U2 * 0.5);
    // Black call screen snaps on instantly when refold begins
    tl.set(coverCall, { opacity: 1, pointerEvents: 'auto' }, closeAt);

    // Phase 4 — hold at call screen
    tl.to({}, { duration: U3 }, closeAt + U2);

    ScrollTrigger.refresh();
  }

  // ─── Intro animation — phone rises in ───────────────────────────────────────
  function playIntro(offset: Offset): Promise<void> {
    return new Promise((resolve) => {
      const phoneWrap = document.getElementById('phoneWrap') as HTMLElement;
      if (!phoneWrap) { resolve(); return; }

      const vh = window.innerHeight;
      gsap.set(phoneWrap, { y: offset.y + vh * 0.4, rotation: -4, scale: 0.88, opacity: 0 });

      let introTl: gsap.core.Timeline | null = null;

      const finish = () => {
        if (introTl) { introTl.kill(); introTl = null; }
        gsap.set(phoneWrap, { y: offset.y, rotation: 0, scale: 1, opacity: 1 });
        window.removeEventListener('scroll', onScroll);
        document.removeEventListener('visibilitychange', finish);
        resolve();
      };

      const onScroll = () => { if (window.scrollY > 60) finish(); };
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('visibilitychange', finish);

      introTl = gsap.timeline({ onComplete: finish });
      introTl.to(phoneWrap, { y: offset.y, rotation: 0, scale: 1, opacity: 1, duration: 0.9, ease: 'power4.out' });

      window.setTimeout(finish, 1200);
    });
  }

  // ─── Bootstrap ──────────────────────────────────────────────────────────────
  async function bootstrap() {
    const phone = document.getElementById('phone') as HTMLElement | null;
    if (!phone) return;

    const { s, mode } = applyScale();
    const offset = getClosedOffset(s, mode);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      gsap.set('#phoneWrap', { x: 0, y: 0, rotation: 0, scale: 1, opacity: 1 });
      initScroll(offset, mode);
      return;
    }

    let firstVisit = true;
    try {
      firstVisit = window.sessionStorage.getItem('ff-seen') !== '1';
      window.sessionStorage.setItem('ff-seen', '1');
    } catch (_) {}

    const canPlay =
      firstVisit &&
      document.visibilityState === 'visible' &&
      window.scrollY < 40;

    initScroll(offset, mode);

    if (canPlay) {
      await playIntro(offset);
      const phone2 = document.getElementById('phone') as HTMLElement | null;
      if (phone2) {
        const { s: freshS, mode: freshMode } = applyScale();
        const freshOffset = getClosedOffset(freshS, freshMode);
        gsap.set('#phoneWrap', { x: freshOffset.x, y: freshOffset.y });
        ScrollTrigger.refresh();
      }
    } else {
      gsap.set('#phoneWrap', { y: offset.y, rotation: 0, scale: 1 });
      gsap.to('#phoneWrap',  { opacity: 1, duration: 0.45, ease: 'power2.out', delay: 0.05 });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () =>
      requestAnimationFrame(() => requestAnimationFrame(bootstrap))
    );
  } else {
    requestAnimationFrame(() => requestAnimationFrame(bootstrap));
  }

  // ─── Resize handler ─────────────────────────────────────────────────────────
  let _rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(_rt);
    _rt = setTimeout(() => {
      ScrollTrigger.getAll().forEach(st => st.kill());
      const { s, mode } = applyScale();
      const off = getClosedOffset(s, mode);
      const isP = mode === 'portrait';

      const wrap      = document.getElementById('phoneWrap');
      const right     = document.getElementById('phoneRight');
      const left      = document.getElementById('phoneLeft');
      const content   = document.getElementById('phoneContent');
      const coverCall = document.getElementById('phoneCoverCall');
      const driver    = document.getElementById('driver');
      const shadeR    = document.getElementById('phoneShadeR');
      const shadeL    = document.getElementById('phoneShadeL');
      const slabR     = document.getElementById('phoneSlabR');
      const glassR    = document.getElementById('phoneGlassR');
      const viewport  = document.getElementById('phoneViewport');

      if (wrap)      gsap.set(wrap,      { x: off.x, y: off.y, rotation: 0, scale: 1, opacity: 1 });
      if (right)     gsap.set(right,     { opacity: 0 });
      if (left)      isP
        ? gsap.set(left, { rotateY: 0, rotateX: -180 })
        : gsap.set(left, { rotateX: 0, rotateY:  180 });
      if (content)   gsap.set(content,   { y: 0 });
      if (coverCall) gsap.set(coverCall, { opacity: 0, pointerEvents: 'none' });
      if (shadeR)    gsap.set(shadeR,    { opacity: 0 });
      if (shadeL)    gsap.set(shadeL,    { opacity: 0 });
      if (slabR)     gsap.set(slabR,     { borderRadius: isP ? '42px 42px 42px 42px' : '46px 46px 46px 46px' });
      if (glassR)    gsap.set(glassR,    { borderRadius: isP ? '38px 38px 38px 38px' : '42px 42px 42px 42px' });
      if (viewport)  gsap.set(viewport,  { borderRadius: isP ? '32px 32px 32px 32px' : '34px 34px 34px 34px' });
      if (shadeR)    gsap.set(shadeR,    { borderRadius: isP ? '42px 42px 42px 42px' : '46px 46px 46px 46px' });
      if (driver)    driver.style.height = '';
      initScroll(off, mode);
    }, 300);
  });
</script>
