---
// Lock Screen — shown on the cover half when device is closed
// SPEC.md: Canvas Slot: Cover / Lock Screen
// CHANGE: portrait, role/city, notifications, social links all need Abiola's real data.
---

<div class="lock" role="region" aria-label="Lock screen">
  <!-- Background portrait placeholder -->
  <div class="lock__portrait" role="img" aria-label="Portrait of Abiola Adeyeye"></div>

  <div class="lock__ui">
    <div class="lock__top">
      <p class="lock__clock">22:00</p>
      <p class="lock__role">IT Support &amp; Motion Designer</p>
    </div>

    <div class="lock__spacer"></div>

    <div class="lock__notifications">
      <a href="#" class="lock__notif">
        <div class="lock__notif-thumb"></div>
        <div class="lock__notif-text">
          <p class="lock__notif-title">Project is live</p>
          <p class="lock__notif-sub">New work · now</p>
        </div>
      </a>
      <a href="#" class="lock__notif">
        <div class="lock__notif-thumb"></div>
        <div class="lock__notif-text">
          <p class="lock__notif-title">Award shortlisted</p>
          <p class="lock__notif-sub">Design awards · 2h ago</p>
        </div>
      </a>
    </div>

    <div class="lock__footer">
      <a href="https://instagram.com" target="_blank" rel="noopener" class="lock__social" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
      </a>
      <span class="lock__hint">Scroll to unfold</span>
      <a href="https://x.com" target="_blank" rel="noopener" class="lock__social" aria-label="X / Twitter">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .lock {
    position: relative;
    width: 100%;
    height: 100%;
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .lock__portrait {
    display: none;
  }

  .lock__ui {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 54px 24px 26px;
    gap: 6px;
  }

  .lock__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .lock__clock {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, var(--text-clock));
    font-weight: 800;
    line-height: var(--leading-clock);
    letter-spacing: var(--tracking-display);
    color: #000;
    text-align: center;
  }

  .lock__role {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    color: #000;
    text-align: center;
  }

  .lock__spacer {
    flex: 1;
  }

  .lock__notifications {
    display: none;
    flex-direction: column;
    gap: 8px;
  }

  .lock__notif {
    background: rgba(255, 255, 255, 0.72);
    border-radius: var(--radius-notification);
    padding: 9px 12px 9px 9px;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lock__notif-thumb {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-thumb);
    background: var(--color-bone);
    flex-shrink: 0;
  }

  .lock__notif-title {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-ink);
    line-height: var(--leading-body);
  }

  .lock__notif-sub {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 400;
    color: var(--color-ink);
    opacity: 0.5;
    line-height: var(--leading-body);
  }

  .lock__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
  }

  .lock__social {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.86);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
  }

  .lock__hint {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.86);
    border-radius: var(--radius-pill);
    padding: 9px 14px;
  }
</style>
