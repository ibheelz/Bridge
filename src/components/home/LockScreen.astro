---
// Lock Screen — shown on the cover half when device is closed
// SPEC.md: Canvas Slot: Cover / Lock Screen
// CHANGE: portrait, role/city, notifications, social links all need Abiola's real data.
---

<div class="lock" role="region" aria-label="Lock screen">
  <!-- Background portrait placeholder -->
  <div class="lock__portrait" role="img" aria-label="Portrait of Abiola Adeyeye"></div>

  <div class="lock__ui">
    <div class="lock__top">
      <p class="lock__clock">22:00</p>
      <p class="lock__role">IT Support &amp; Motion Designer</p>
    </div>

    <div class="lock__spacer"></div>

    <div class="lock__notifications">
      <a href="#" class="lock__notif">
        <div class="lock__notif-thumb"></div>
        <div class="lock__notif-text">
          <p class="lock__notif-title">Project is live</p>
          <p class="lock__notif-sub">New work · now</p>
        </div>
      </a>
      <a href="#" class="lock__notif">
        <div class="lock__notif-thumb"></div>
        <div class="lock__notif-text">
          <p class="lock__notif-title">Award shortlisted</p>
          <p class="lock__notif-sub">Design awards · 2h ago</p>
        </div>
      </a>
    </div>

  </div>
</div>

<style>
  .lock {
    position: relative;
    width: 100%;
    height: 100%;
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .lock__portrait {
    display: none;
  }

  .lock__ui {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 54px 24px 26px;
    gap: 6px;
  }

  .lock__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .lock__clock {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, var(--text-clock));
    font-weight: 800;
    line-height: var(--leading-clock);
    letter-spacing: var(--tracking-display);
    color: #000;
    text-align: center;
  }

  .lock__role {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    color: #000;
    text-align: center;
  }

  .lock__spacer {
    flex: 1;
  }

  .lock__notifications {
    display: none;
    flex-direction: column;
    gap: 8px;
  }

  .lock__notif {
    background: rgba(255, 255, 255, 0.72);
    border-radius: var(--radius-notification);
    padding: 9px 12px 9px 9px;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lock__notif-thumb {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-thumb);
    background: var(--color-bone);
    flex-shrink: 0;
  }

  .lock__notif-title {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-ink);
    line-height: var(--leading-body);
  }

  .lock__notif-sub {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 400;
    color: var(--color-ink);
    opacity: 0.5;
    line-height: var(--leading-body);
  }

</style>
