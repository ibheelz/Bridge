---
// Section 1 — Hero (phone screen)
// Fits in one phone viewport (660px tall × 488px wide). No portrait.
---

<section class="hero" aria-label="Introduction">
  <div class="hero__content">
    <h1 class="hero__name">Abiola Adeyeye</h1>
    <p class="hero__tagline">[tagline]</p>
    <div class="hero__ctas">
      <a href="/work" class="hero__btn hero__btn--primary">See the work ↗</a>
      <a href="/contact" class="hero__btn hero__btn--ghost">Say hello</a>
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    height: 660px;
    display: flex;
    align-items: center;
    background: var(--color-paper);
    padding: 0 var(--page-padding-x);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(36px, 8vw, 64px);
    font-weight: 900;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .hero__tagline {
    font-family: var(--font-ui);
    font-size: var(--text-lead);
    font-weight: 400;
    line-height: var(--leading-lead);
    color: rgba(17, 17, 17, 0.45);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }

  .hero__btn {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1;
    border-radius: var(--radius-pill);
    padding: 13px 20px;
    display: inline-flex;
    align-items: center;
  }

  .hero__btn--primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__btn--ghost {
    background: rgba(17, 17, 17, 0.07);
    color: var(--color-ink);
  }
</style>
