---
// Call Screen — incoming call overlay after device closes
// SPEC.md: Canvas Slot: Call Screen
// CHANGE: name, email, avatar need Abiola's real data.
---

<div class="call" role="region" aria-label="Incoming call screen">
  <!-- Background portrait -->
  <div class="call__portrait" role="img" aria-label="Portrait of Abiola Adeyeye"></div>

  <!-- Dark overlay -->
  <div class="call__overlay">
    <p class="call__name">Abiola Adeyeye</p>
    <p class="call__subtitle">Incoming call · about your next project</p>

    <div class="call__spacer-sm"></div>

    <div class="call__avatar" role="img" aria-label="Avatar of Abiola Adeyeye"></div>

    <div class="call__spacer"></div>

    <a href="/contact" class="call__slide">
      <span class="call__knob">✆</span>
      <span class="call__slide-label">slide to talk</span>
    </a>

    <p class="call__email">hello@abioladeyeye.com</p>
  </div>
</div>

<style>
  .call {
    position: relative;
    width: 100%;
    height: 100%;
    background: rgb(20, 18, 16);
    overflow: hidden;
  }

  .call__portrait {
    position: absolute;
    inset: 0;
    background: var(--color-bone);
    opacity: 0.38;
  }

  .call__overlay {
    position: relative;
    z-index: 1;
    background: rgba(0, 0, 0, 0.25);
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 72px 26px 30px;
  }

  .call__name {
    font-family: var(--font-display);
    font-size: clamp(40px, 8vw, var(--text-s));
    font-weight: 900;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
    color: var(--color-paper);
    text-align: center;
  }

  .call__subtitle {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-paper);
    opacity: 0.7;
    text-align: center;
    margin-top: 6px;
  }

  .call__spacer-sm {
    height: 30px;
    flex-shrink: 0;
  }

  .call__avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--color-bone);
    overflow: hidden;
  }

  .call__spacer {
    flex: 1;
  }

  .call__slide {
    width: 100%;
    background: rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill);
    height: 62px;
    padding: 6px;
    display: flex;
    align-items: center;
    position: relative;
  }

  .call__knob {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--color-accent-call);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .call__slide-label {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-paper);
    text-align: center;
    flex: 1;
    padding-right: 50px;
  }

  .call__email {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-paper);
    opacity: 0.5;
    text-align: center;
    margin-top: 8px;
  }
</style>
