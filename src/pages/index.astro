---
import fs from 'node:fs';
import path from 'node:path';

// List what the user has put in public/assets/ so the client knows, without
// probing for 404s, whether to load real models or build the placeholder room.
// The `?v=` is the file's modification time: a replaced file gets a new URL.
const assetsDir = path.join(process.cwd(), 'public', 'assets');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assets = fs.existsSync(assetsDir)
  ? fs
      .readdirSync(assetsDir)
      .filter((file) => /\.(glb|gltf|jpe?g|png|webp)$/i.test(file))
      .sort()
      .map((file) => {
        const version = Math.round(fs.statSync(path.join(assetsDir, file)).mtimeMs).toString(36);
        return `${base}assets/${encodeURIComponent(file)}?v=${version}`;
      })
  : [];

// The TV plays the first video in public/assets/screens/, if there is one.
const screensDir = path.join(assetsDir, 'screens');
const tvFile = fs.existsSync(screensDir)
  ? fs.readdirSync(screensDir).filter((file) => /\.(mp4|webm)$/i.test(file)).sort()[0]
  : undefined;
const tvVideo = tvFile ? `${base}assets/screens/${encodeURIComponent(tvFile)}` : undefined;
const hasRoom = assets.some((url) => /\/roomModel\.glb\?/.test(url));
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <title>Abiola Adeyeye</title>
    <script is:inline>
      // Coming back from the portfolio: start under black, before anything paints.
      if (location.hash === '#powerdown') document.documentElement.classList.add('is-powerdown');
    </script>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #010101;
        overscroll-behavior: none;
      }
      .page {
        position: fixed;
        inset: 0;
        background: #010101;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
      }
      .stage,
      .room-experience {
        position: absolute;
        inset: 0;
      }
      .room-experience {
        overflow: hidden;
        background: radial-gradient(120% 90% at 50% 38%, #ffffff 0, #f1eee8 55%, #dcd7cf);
      }
      /* Labels will sit at z-index 1, behind this transparent canvas layer. */
      .room-experience__target {
        position: absolute;
        inset: 0;
        z-index: 2;
      }
      /* Spec colours are near-white on a near-white page; ink is used instead. */
      .loading {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 5;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        pointer-events: none;
        opacity: 1;
        transition: opacity 0.6s ease;
      }
      .loading.is-done { opacity: 0; }
      .loading__bar {
        width: 180px;
        height: 2px;
        overflow: hidden;
        background: #2d2b2826;
      }
      .loading__fill {
        width: 100%;
        height: 100%;
        background: #2d2b28;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.3s ease;
      }
      /* Full-screen black for leaving to, and arriving from, the portfolio (CRT mode). */
      .blackout {
        position: fixed;
        inset: 0;
        z-index: 60;
        background: #000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.45s ease;
      }
      .blackout.is-on,
      .is-powerdown .blackout {
        opacity: 1;
        transition: none;
      }
      /* Laptop panel (suite mode). Darker than the spec's #0a0a0a61 so the pale text reads over a pale room. */
      .suite {
        position: fixed;
        left: 50%;
        top: 50%;
        z-index: 20;
        width: min(430px, calc(100% - 32px));
        max-height: calc(100% - 32px);
        overflow: auto;
        transform: translate(-50%, -50%);
        padding: 30px 32px 24px;
        border: 1px solid hsla(40, 26%, 93%, 0.14);
        border-radius: 12px;
        background: #0a0a0ab8;
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        backdrop-filter: blur(16px) saturate(120%);
        box-shadow: inset 0 1px #f2efe912;
        color: #f2efe9;
        font: 14px/1.4 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.4s ease, visibility 0s linear 0.4s;
      }
      .suite.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition: opacity 0.4s ease;
      }
      .suite__close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: inherit;
        font-size: 20px;
        line-height: 1;
        opacity: 0.6;
        cursor: pointer;
      }
      .suite__close:hover,
      .suite__close:focus-visible { opacity: 1; }
      .suite__kicker {
        font-size: 10px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        opacity: 0.6;
      }
      .suite__title {
        margin: 8px 0 14px;
        font-size: 20px;
        font-weight: 500;
      }
      .suite__rows { list-style: none; }
      .suite__row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2px 16px;
        align-items: baseline;
        padding: 12px 0;
        border-top: 1px solid hsla(40, 26%, 93%, 0.14);
      }
      .suite__name { font-weight: 500; }
      .suite__status {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.6;
      }
      .suite__blurb {
        grid-column: 1 / -1;
        font-size: 12px;
        opacity: 0.6;
      }
      .suite__footer {
        padding-top: 14px;
        border-top: 1px solid hsla(40, 26%, 93%, 0.14);
        font-size: 11px;
        opacity: 0.4;
      }
      .loading__percent {
        font: 12px/1 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        letter-spacing: 0.12em;
        font-variant-numeric: tabular-nums;
        color: #6b6760;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="stage">
        <div class="room-experience">
          <div
            id="room"
            class="room-experience__target"
            data-assets={JSON.stringify(assets)}
            data-draco={`${base}draco/`}
            data-tv-video={tvVideo}
            data-portfolio={`${base}portfolio/`}
          >
          </div>
          {
            hasRoom && (
              <div class="loading" role="progressbar" aria-label="Loading room" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div class="loading__bar"><div class="loading__fill" /></div>
                <span class="loading__percent">0%</span>
              </div>
            )
          }
        </div>
      </div>
    </main>
    <aside class="suite" role="dialog" aria-label="Laptop" aria-hidden="true" inert>
      <button class="suite__close" type="button" aria-label="Close">&times;</button>
      <p class="suite__kicker">Placeholder kicker</p>
      <h2 class="suite__title">Placeholder title</h2>
      <ul class="suite__rows">
        <li class="suite__row">
          <span class="suite__name">Placeholder item one</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the first item.</span>
        </li>
        <li class="suite__row">
          <span class="suite__name">Placeholder item two</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the second item.</span>
        </li>
        <li class="suite__row">
          <span class="suite__name">Placeholder item three</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the third item.</span>
        </li>
      </ul>
      <p class="suite__footer">Placeholder footer line</p>
    </aside>
    <div class="blackout" aria-hidden="true"></div>
    <script>
      import Experience from '../room/Experience';
      import { initLoading } from '../ui/loading';
      import { initSuite } from '../ui/suite';

      initSuite(document.querySelector<HTMLElement>('.suite'));
      const target = document.getElementById('room');
      if (target) {
        const experience = new Experience({
          targetElement: target,
          assets: JSON.parse(target.dataset.assets ?? '[]') as string[],
          dracoPath: target.dataset.draco,
          tvVideo: target.dataset.tvVideo || undefined,
          portfolioUrl: target.dataset.portfolio,
        });
        initLoading(document.querySelector<HTMLElement>('.loading'), experience.resources);
      }
    </script>
  </body>
</html>
