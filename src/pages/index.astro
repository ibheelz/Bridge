---
import fs from 'node:fs';
import path from 'node:path';

// List what the user has put in public/assets/ so the client knows, without
// probing for 404s, whether to load real models or build the placeholder room.
// The `?v=` is the file's modification time: a replaced file gets a new URL.
const assetsDir = path.join(process.cwd(), 'public', 'assets');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assets = fs.existsSync(assetsDir)
  ? fs
      .readdirSync(assetsDir)
      .filter((file) => /\.(glb|gltf|jpe?g|png|webp)$/i.test(file))
      .sort()
      .map((file) => {
        const version = Math.round(fs.statSync(path.join(assetsDir, file)).mtimeMs).toString(36);
        return `${base}assets/${encodeURIComponent(file)}?v=${version}`;
      })
  : [];

// The TV plays the first video in public/assets/screens/, if there is one.
const screensDir = path.join(assetsDir, 'screens');
const tvFile = fs.existsSync(screensDir)
  ? fs.readdirSync(screensDir).filter((file) => /\.(mp4|webm)$/i.test(file)).sort()[0]
  : undefined;
const tvVideo = tvFile ? `${base}assets/screens/${encodeURIComponent(tvFile)}` : undefined;
const hasRoom = assets.some((url) => /\/roomModel\.glb\?/.test(url));
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>Abiola Adeyeye</title>
    <script is:inline>
      // Coming back from the portfolio: start under black, before anything paints.
      if (location.hash === '#powerdown') document.documentElement.classList.add('is-powerdown');
    </script>
    <noscript><style>.overlay, .edge-word, .room-keys { display: none; }</style></noscript>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #010101;
        overscroll-behavior: none;
      }
      .page {
        position: fixed;
        inset: 0;
        background: #010101;
        user-select: none;
        -webkit-user-select: none;
      }
      .stage,
      .room-experience {
        position: absolute;
        inset: 0;
      }
      .room-experience {
        overflow: hidden;
        background: radial-gradient(120% 90% at 50% 38%, #ffffff 0, #f1eee8 55%, #dcd7cf);
      }
      /* Labels will sit at z-index 1, behind this transparent canvas layer. */
      /* touch-action here, not on the page: pinch zooms the room, while the rest of the page stays zoomable. */
      .room-experience__target {
        position: absolute;
        inset: 0;
        z-index: 2;
        touch-action: none;
      }
      /* Edge words (section 10). Text at z 1 behind the transparent canvas (z 2); proxies at z 6 take the clicks. */
      .edge-word {
        position: absolute;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-align: center;
        color: #2d2b28;
        font: 14px/1.2 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        pointer-events: none;
        opacity: 0;
        transition: opacity 1.6s ease, color 0.4s ease;
      }
      .edge-word__word {
        letter-spacing: 0.35em;
        margin-right: -0.35em;
        text-transform: lowercase;
      }
      .edge-word__year {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.25em;
        margin-right: -0.25em;
        color: #6b6760;
      }
      .edge-word__role,
      .edge-word__sub {
        font-size: 11px;
        color: #8a867f;
        transition: opacity 0.45s ease;
      }
      .edge-word__sub {
        font-style: italic;
        letter-spacing: 0.2em;
        margin-right: -0.2em;
      }
      .edge-word--left,
      .edge-word--right {
        top: 50%;
      }
      .edge-word--left {
        left: 14%;
        transform: translate(-50%, -50%);
      }
      .edge-word--right {
        right: 14%;
        transform: translate(50%, -50%);
      }
      .edge-word--top {
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
      }
      .edge-word--corners .edge-word--left,
      .edge-word--corners .edge-word--right {
        top: auto;
        bottom: calc(18px + env(safe-area-inset-bottom));
        transform: none;
      }
      .edge-word--corners .edge-word--left {
        left: calc(24px + env(safe-area-inset-left));
        align-items: flex-start;
      }
      .edge-word--corners .edge-word--right {
        right: calc(24px + env(safe-area-inset-right));
        align-items: flex-end;
      }
      .edge-words-in .edge-word { opacity: 1; }
      .edge-words-in .edge-word--left { opacity: 0.75; }
      .edge-words-in .edge-word--left.is-hot { opacity: 1; }
      .edge-words-hidden .edge-word,
      .edge-words-hidden .edge-word--left.is-hot {
        opacity: 0;
        transition-duration: 0.4s;
      }
      .edge-word--lumaflip,
      .edge-word--lumaflip .edge-word__year,
      .edge-word--lumaflip .edge-word__role,
      .edge-word--lumaflip .edge-word__sub {
        color: #f2efe9;
      }
      button.edge-word {
        z-index: 6;
        padding: 0;
        border: 0;
        background: none;
        color: transparent;
        opacity: 1;
        pointer-events: auto;
        cursor: pointer;
      }
      .edge-words-in button.edge-word { opacity: 1; }
      button.edge-word:disabled { pointer-events: none; cursor: default; }
      button.edge-word:focus { outline: none; }
      button.edge-word:focus-visible {
        outline: 2px solid #2d2b28;
        outline-offset: 6px;
        border-radius: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        .edge-word,
        .edge-word__role,
        .edge-word__sub { transition: none !important; }
      }
      /* Settings and sound (section 10, "Overlay buttons"); padded to a 44 px hit area. */
      .overlay__button {
        position: fixed;
        top: clamp(14px, 3vh, 28px);
        right: clamp(16px, 3vw, 32px);
        z-index: 10;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin: -13px -13px 0 0;
        padding: 13px;
        border: 0;
        border-radius: 8px;
        background: none;
        color: #2d2b2859;
        cursor: pointer;
        transition: color 0.2s ease, opacity 0.4s ease;
      }
      .overlay__button.settings {
        right: calc(clamp(16px, 3vw, 32px) + 34px);
      }
      .overlay__button:hover,
      .overlay__button:focus-visible {
        color: #2d2b28d9;
      }
      .overlay__button:focus { outline: none; }
      .overlay__button:focus-visible { outline: 2px solid #2d2b28; outline-offset: -4px; }
      .overlay__button svg {
        display: block;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .sound__off,
      .sound.is-muted .sound__wave { display: none; }
      .sound.is-muted .sound__off { display: inline; }
      .overlay.is-hidden .overlay__button {
        opacity: 0;
        pointer-events: none;
      }
      /* Shown instead of the room without WebGL or JavaScript (section 13.4). */
      .fallback {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 3;
        transform: translate(-50%, -50%);
        width: min(420px, calc(100% - 32px));
        text-align: center;
        color: #2d2b28;
        font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        user-select: text;
        -webkit-user-select: text;
      }
      .fallback[hidden] { display: none; }
      .fallback__name {
        margin-bottom: 10px;
        font-size: 22px;
        letter-spacing: 0.06em;
      }
      .fallback__text { color: #6b6760; margin-bottom: 18px; }
      .fallback__link { color: #2d2b28; }
      .no-webgl .fallback { display: block; }
      .no-webgl .overlay,
      .no-webgl .edge-word { display: none; }
      /* Keyboard routes to the laptop and TV: hidden until focused (section 13.4). */
      .room-keys__button {
        position: absolute;
        left: 50%;
        bottom: calc(18px + env(safe-area-inset-bottom));
        z-index: 7;
        transform: translateX(-50%);
        padding: 10px 16px;
        border: 0;
        border-radius: 8px;
        background: #2d2b28;
        color: #f2efe9;
        font: 13px/1 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        letter-spacing: 0.06em;
        cursor: pointer;
        clip-path: inset(50%);
        opacity: 0;
      }
      .room-keys__button:focus-visible {
        clip-path: none;
        opacity: 1;
        outline: 2px solid #2d2b28;
        outline-offset: 3px;
      }
      .no-webgl .room-keys { display: none; }
      /* Spec colours are near-white on a near-white page; ink is used instead. */
      .loading {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 5;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        pointer-events: none;
        opacity: 1;
        transition: opacity 0.6s ease;
      }
      .loading.is-done { opacity: 0; }
      .loading__bar {
        width: 180px;
        height: 2px;
        overflow: hidden;
        background: #2d2b2826;
      }
      .loading__fill {
        width: 100%;
        height: 100%;
        background: #2d2b28;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.3s ease;
      }
      /* Full-screen black for leaving to, and arriving from, the portfolio (CRT mode). */
      .blackout {
        position: fixed;
        inset: 0;
        z-index: 60;
        background: #000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.45s ease;
      }
      .blackout.is-on,
      .is-powerdown .blackout {
        opacity: 1;
        transition: none;
      }
      /* Laptop panel (suite mode). Darker than the spec's #0a0a0a61 so the pale text reads over a pale room. */
      .suite {
        position: fixed;
        left: 50%;
        top: 50%;
        z-index: 20;
        width: min(430px, calc(100% - 32px));
        max-height: calc(100% - 32px);
        overflow: auto;
        transform: translate(-50%, -50%);
        padding: 30px 32px 24px;
        border: 1px solid hsla(40, 26%, 93%, 0.14);
        border-radius: 12px;
        background: #0a0a0ab8;
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        backdrop-filter: blur(16px) saturate(120%);
        box-shadow: inset 0 1px #f2efe912;
        color: #f2efe9;
        font: 14px/1.4 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.4s ease, visibility 0s linear 0.4s;
      }
      .suite.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition: opacity 0.4s ease;
      }
      .suite__close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: inherit;
        font-size: 20px;
        line-height: 1;
        opacity: 0.6;
        cursor: pointer;
      }
      .suite__close:hover,
      .suite__close:focus-visible { opacity: 1; }
      .suite__kicker {
        font-size: 10px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        opacity: 0.6;
      }
      .suite__title {
        margin: 8px 0 14px;
        font-size: 20px;
        font-weight: 500;
      }
      .suite__rows { list-style: none; }
      .suite__row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2px 16px;
        align-items: baseline;
        padding: 12px 0;
        border-top: 1px solid hsla(40, 26%, 93%, 0.14);
      }
      .suite__name { font-weight: 500; }
      .suite__status {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.6;
      }
      .suite__blurb {
        grid-column: 1 / -1;
        font-size: 12px;
        opacity: 0.6;
      }
      .suite__footer {
        padding-top: 14px;
        border-top: 1px solid hsla(40, 26%, 93%, 0.14);
        font-size: 11px;
        opacity: 0.4;
      }
      .loading__percent {
        font: 12px/1 ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        letter-spacing: 0.12em;
        font-variant-numeric: tabular-nums;
        color: #6b6760;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="stage">
        <div class="room-experience">
          <div
            id="room"
            class="room-experience__target"
            data-assets={JSON.stringify(assets)}
            data-draco={`${base}draco/`}
            data-tv-video={tvVideo}
            data-portfolio={`${base}portfolio/`}
          >
          </div>
          <div class="fallback" hidden>
          <p class="fallback__name">Placeholder name</p>
          <p class="fallback__text">Placeholder line: this page needs WebGL to show the room.</p>
          <a class="fallback__link" href={`${base}portfolio/`}>Open the portfolio</a>
          </div>
          <noscript>
            <div class="fallback fallback--static">
          <p class="fallback__name">Placeholder name</p>
          <p class="fallback__text">Placeholder line: this page needs WebGL to show the room.</p>
          <a class="fallback__link" href={`${base}portfolio/`}>Open the portfolio</a>
            </div>
          </noscript>
          <span class="edge-word edge-word--left" data-luma="portfolio">
            <span class="edge-word__year">(year)</span>
            <span class="edge-word__word">placeholder left</span>
          </span>
          <button class="edge-word edge-word--left edge-word--proxy" type="button" aria-label="Open the computer" disabled></button>
          <span class="edge-word edge-word--right" data-luma="software">
            <span class="edge-word__year">(year)</span>
            <span class="edge-word__word">placeholder right</span>
            <span class="edge-word__sub">coming soon</span>
          </span>
          <span class="edge-word edge-word--top" data-luma="wordmark">
            <span class="edge-word__word">placeholder name</span>
            <span class="edge-word__role" aria-live="off">placeholder role one</span>
          </span>
          <button class="edge-word edge-word--top edge-word--roleproxy" type="button" aria-label="Next role" disabled></button>
          <div class="room-keys">
            <button class="room-keys__button room-keys__laptop" type="button">Open the laptop</button>
            <button class="room-keys__button room-keys__tv" type="button">Watch the TV</button>
          </div>
          {
            hasRoom && (
              <div class="loading" role="progressbar" aria-label="Loading room" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div class="loading__bar"><div class="loading__fill" /></div>
                <span class="loading__percent">0%</span>
              </div>
            )
          }
        </div>
      </div>
      <div class="overlay">
        <button class="overlay__button settings" type="button" aria-label="Settings">
          <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
            <path d="M2.5 5h7M13.5 5h2M2.5 13h2M8.5 13h7" />
            <circle cx="11.5" cy="5" r="2" />
            <circle cx="6.5" cy="13" r="2" />
          </svg>
        </button>
        <button class="overlay__button sound" type="button" aria-label="Sound" aria-pressed="false">
          <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
            <path d="M2.5 7h2.5l4-3.5v11l-4-3.5h-2.5z" />
            <path class="sound__wave" d="M11.5 6.6a3.4 3.4 0 0 1 0 4.8M13.6 4.5a6.4 6.4 0 0 1 0 9" />
            <path class="sound__off" d="M12 6.5l5 5M17 6.5l-5 5" />
          </svg>
        </button>
      </div>
    </main>
    <aside class="suite" role="dialog" aria-label="Laptop" aria-hidden="true" inert>
      <button class="suite__close" type="button" aria-label="Close">&times;</button>
      <p class="suite__kicker">Placeholder kicker</p>
      <h2 class="suite__title">Placeholder title</h2>
      <ul class="suite__rows">
        <li class="suite__row">
          <span class="suite__name">Placeholder item one</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the first item.</span>
        </li>
        <li class="suite__row">
          <span class="suite__name">Placeholder item two</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the second item.</span>
        </li>
        <li class="suite__row">
          <span class="suite__name">Placeholder item three</span>
          <span class="suite__status">Status</span>
          <span class="suite__blurb">Placeholder blurb for the third item.</span>
        </li>
      </ul>
      <p class="suite__footer">Placeholder footer line</p>
    </aside>
    <div class="blackout" aria-hidden="true"></div>
    <script>
      import Experience from '../room/Experience';
      import { initLoading } from '../ui/loading';
      import { initSuite } from '../ui/suite';
      import { initLabels } from '../ui/labels';
      import { initRoomRect } from '../ui/roomRect';
      import { initLumaProbe } from '../ui/lumaProbe';
      import { initOverlay } from '../ui/overlay';
      import { initRoomKeys } from '../ui/roomKeys';

      initSuite(document.querySelector<HTMLElement>('.suite'));
      initLabels(document.querySelector<HTMLElement>('.room-experience'));
      initOverlay(document.querySelector<HTMLElement>('.overlay'));
      initRoomKeys(document.querySelector<HTMLElement>('.room-keys'));

      /** A throwaway canvas tells whether WebGL is there before the room is built. */
      function hasWebGL(): boolean {
        try {
          const canvas = document.createElement('canvas');
          return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
        } catch {
          return false;
        }
      }

      function showFallback(): void {
        document.querySelector('.page')?.classList.add('no-webgl');
        document.querySelector<HTMLElement>('.fallback')?.removeAttribute('hidden');
        document.documentElement.classList.remove('is-powerdown');
      }

      const target = document.getElementById('room');
      if (target && !hasWebGL()) showFallback();
      else if (target) {
        try {
          const experience = new Experience({
            targetElement: target,
            assets: JSON.parse(target.dataset.assets ?? '[]') as string[],
            dracoPath: target.dataset.draco,
            tvVideo: target.dataset.tvVideo || undefined,
            portfolioUrl: target.dataset.portfolio,
          });
          initLoading(document.querySelector<HTMLElement>('.loading'), experience.resources);
          initRoomRect(experience);
          initLumaProbe(experience);
        } catch (error) {
          console.warn('[room] the room could not start; showing the plain page.', error);
          window.experience?.time?.destroy();
          showFallback();
        }
      }
    </script>
  </body>
</html>
